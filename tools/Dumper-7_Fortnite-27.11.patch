diff --git a/Dumper/Engine/Public/Unreal/FortniteNameXor.h b/Dumper/Engine/Public/Unreal/FortniteNameXor.h
new file mode 100644
index 0000000..538da2a
--- /dev/null
+++ b/Dumper/Engine/Public/Unreal/FortniteNameXor.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cstdint>
+
+/*
+* ATLAS Fortnite 27.11 stores FName strings XOR-obfuscated in the name pool.
+* The game decodes them in FNameEntry::AppendNameToString (exe+0xE70572 ansi, exe+0x400DE31 wide):
+*     State = 0x2A; for each char i: State |= i; Char ^= ~State; State <<= 1;
+* The key depends only on the character position, so encoding and decoding are the same operation.
+*/
+namespace FortniteNameXor
+{
+	inline constexpr bool bEnabled = true;
+
+	template<typename CharType>
+	inline void Decode(CharType* Str, int32_t Len)
+	{
+		if constexpr (!bEnabled)
+			return;
+
+		uint32_t State = 0x2A;
+		for (int32_t i = 0; i < Len; i++)
+		{
+			State |= static_cast<uint32_t>(i);
+			Str[i] = static_cast<CharType>(Str[i] ^ static_cast<CharType>(~State));
+			State <<= 1;
+		}
+	}
+
+	/* Key byte for an ansi character at string position Pos */
+	constexpr uint8_t KeyAt(int32_t Pos)
+	{
+		uint32_t State = 0x2A;
+		uint8_t Key = 0;
+		for (int32_t i = 0; i <= Pos; i++)
+		{
+			State |= static_cast<uint32_t>(i);
+			Key = static_cast<uint8_t>(~State);
+			State <<= 1;
+		}
+		return bEnabled ? Key : 0;
+	}
+
+	/* Little-endian integer of N chars of Str as they appear encoded in memory, Str starting at string position 0 */
+	template<typename IntType>
+	constexpr IntType Encoded(const char* Str)
+	{
+		IntType Out = 0;
+		for (int32_t i = 0; i < static_cast<int32_t>(sizeof(IntType)); i++)
+			Out |= static_cast<IntType>(static_cast<uint8_t>(Str[i]) ^ KeyAt(i)) << (i * 8);
+		return Out;
+	}
+}
